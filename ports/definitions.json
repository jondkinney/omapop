  "pgh8tr": {
    "description": "Replace each Unicode character with a mask. Keeping the original on the clipboard is optional.",
    "files": {
      "local.js": "local.js"
    },
    "config": {
      "actions": [
        {
          "title": "Mask text",
          "javascript": "const result = require('./local.js').mosaic(popclip.input.text,popclip.options); await popclip.pasteText(result); if(popclip.options.keepOriginal) await popclip.copyText(popclip.input.text,{notify:false});"
        }
      ],
      "options": [
        {
          "identifier": "mosaic-code",
          "label": "Mask",
          "type": "string",
          "default value": "*"
        },
        {
          "identifier": "keepOriginal",
          "label": "Keep original text on clipboard",
          "type": "boolean",
          "default value": false
        }
      ]
    }
  },
  "8f2t12": {
    "description": "Append selected text to the clipboard with a configurable separator (128 KiB limit).",
    "config": {
      "options": [
        {
          "identifier": "separator",
          "label": "Separator",
          "type": "string",
          "default value": "\n"
        }
      ],
      "javascript": "const text = pasteboard.text + String(popclip.options.separator) + popclip.input.text; if(new TextEncoder().encode(text).length>131072) throw new Error('Clipboard result exceeds 128 KiB'); await popclip.copyText(text);"
    }
  },
  "2x5yjg": {
    "description": "Paste the previous clipboard text, then copy the replaced selection.",
    "config": {
      "javascript": "const previous = pasteboard.text; const selected = popclip.input.text; await popclip.pasteText(previous); await popclip.copyText(selected,{notify:false});",
      "requirements": [
        "text",
        "paste"
      ]
    }
  },
